# Copy to .env (already done on your laptop). Never upload .env to GitHub.
PORT=3000
DATABASE_URL="postgresql://sales:sales_password@localhost:5432/sales_app?schema=public"
# Website addresses allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:3001,https://*.vercel.app

# --- API keys (paste values after the = sign) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Daily AI spend cap in US dollars (rolling 24 hours). 0 turns the AI off; the assistant then uses plain search.
AI_DAILY_BUDGET_USD=5
EBAY_APP_ID=
EBAY_CERT_ID=
TICKETMASTER_API_KEY=
TRAVELPAYOUTS_TOKEN=
GOOGLE_SAFE_BROWSING_KEY=

# Click events are deleted after this many days (minimum 30, default 730)
CLICK_RETENTION_DAYS=730

# --- Admin dashboard + partner outreach ---
# Long random strings. ADMIN_API_KEY must be the same value in web/.env.local (and in Vercel).
ADMIN_API_KEY=
OUTREACH_SECRET=
# Website address, used for links in Telegram alerts
WEB_URL=http://localhost:3001
# Outreach mailbox (Google Workspace). Run `npm run gmail:connect` to get the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Phone alerts: create a bot with @BotFather, then message it and look up your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
