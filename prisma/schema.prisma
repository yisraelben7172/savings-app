// Vault deals database
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  GOLD
}

enum DealStatus {
  ACTIVE
  HIDDEN
  EXPIRED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  color     String // design token name, e.g. "sky"
  sortOrder Int       @default(0)
  deals     Deal[]
  products  Product[]
}

enum IntegrationType {
  NONE // listed, no data connection yet
  FEED // partner-provided CSV/XML file
  RETAILER_API
  NETWORK_API // via an affiliate network (Impact, CJ, Awin...)
  MANUAL
}

enum AffiliateStatus {
  NOT_APPLIED
  APPLIED
  APPROVED
  REJECTED
}

enum HealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  FAILING
}

// A store (the retailer registry). Only approved merchants with trustScore >= 70 are ever shown.
model Merchant {
  id                  String             @id @default(cuid())
  slug                String             @unique
  name                String
  domain              String             @unique // links must point at this domain
  network             String // amazon, ebay, impact, cj, expedia, booking, travelpayouts...
  affiliateTag        String? // e.g. Amazon associate tag (not a secret)
  trustScore          Int                @default(0)
  approved            Boolean            @default(false)
  rating              Float?
  color               String             @default("sky")
  active              Boolean            @default(true)
  integrationType     IntegrationType    @default(NONE)
  affiliateStatus     AffiliateStatus    @default(NOT_APPLIED)
  supportedCategories String[]           @default([])
  linkCapability      String? // how tracked links are made, e.g. "amazon-tag", "impact-deeplink" (once verified)
  complianceNotes     String?
  lastSyncAt          DateTime?
  health              HealthStatus       @default(UNKNOWN)
  healthNote          String?
  offers              Offer[]
  sources             DataSource[]
  programs            AffiliateProgram[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

enum SourceKind {
  DEMO // our sample catalog (prisma/seed.ts)
  CSV_FEED
  XML_FEED
  RETAILER_API
  NETWORK_API
  MANUAL
}

enum SourceStatus {
  AWAITING_APPROVAL // permission not confirmed: never collect data
  ACTIVE
  PAUSED
  DISABLED
}

// Where catalog data comes from, and what we're allowed to do with it.
// Secrets never go here: credentials live in the API's environment.
model DataSource {
  id                  String         @id @default(cuid())
  name                String
  kind                SourceKind
  status              SourceStatus   @default(AWAITING_APPROVAL)
  merchantId          String?
  merchant            Merchant?      @relation(fields: [merchantId], references: [id])
  // Permission record (must be filled in before the source can be activated)
  accessMethod        String? // e.g. "Partner emails a daily CSV", "Impact Catalog API"
  agreementUrl        String?
  permissionNotes     String?
  allowedFields       String[]       @default([])
  aiUseAllowed        Boolean        @default(false) // may this data be sent to Claude?
  attributionText     String? // shown next to prices when required
  priceFreshnessHours Int            @default(24) // older offers are hidden, never shown as live
  retentionDays       Int? // delete price history older than this (null = keep)
  fullSnapshot        Boolean        @default(true) // each import is the whole catalog: missing SKUs go out of stock
  config              Json? // non-secret settings, e.g. CSV column mapping
  approvedAt          DateTime?
  approvedBy          String?
  lastRunAt           DateTime?
  health              HealthStatus   @default(UNKNOWN)
  healthNote          String?
  offers              Offer[]
  runs                IngestionRun[]
  priceHistory        PriceHistory[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL // some rows rejected
  FAILED
}

model IngestionRun {
  id         String     @id @default(cuid())
  sourceId   String
  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     RunStatus  @default(RUNNING)
  trigger    String // "admin-upload", "schedule"...
  fileHash   String?
  rowsRead   Int        @default(0)
  created    Int        @default(0)
  updated    Int        @default(0)
  unchanged  Int        @default(0)
  rejected   Int        @default(0)
  markedOut  Int        @default(0) // SKUs missing from a full snapshot
  errors     Json? // first rejected rows: [{ row, code, message }]
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
}

// The canonical item, independent of who sells it. Matched only by identifiers, never by title.
model Product {
  id           String   @id @default(cuid())
  title        String
  brand        String?
  brandKey     String? // lowercase brand for matching
  manufacturer String?
  model        String?
  mpn          String?
  mpnKey       String? // MPN uppercase, letters and digits only
  gtin         String?  @unique // normalized to 14 digits, check digit verified
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  subcategory  String?
  description  String?
  attributes   Json? // specs and variant info (size, color...)
  imageUrl     String? // only where the source permits images
  deals        Deal[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([brandKey, mpnKey])
  @@index([categoryId])
}

// The listing shoppers see for one product: its current best price across stores.
model Deal {
  id             String         @id @default(cuid())
  slug           String         @unique
  productId      String?        @unique // null for demo deals made before products existed
  product        Product?       @relation(fields: [productId], references: [id])
  title          String
  description    String?
  imageUrl       String?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  originalPrice  Decimal        @db.Decimal(12, 2)
  bestPrice      Decimal        @db.Decimal(12, 2)
  priceUnit      String? // "per day", "per night"
  discountPct    Int
  isHot          Boolean        @default(false)
  goldOnly       Boolean        @default(false)
  goldEarlyUntil DateTime? // free users see it only after this time
  status         DealStatus     @default(ACTIVE)
  expiresAt      DateTime?
  offers         Offer[]
  priceHistory   PriceHistory[]
  savedBy        SavedDeal[]
  alerts         Alert[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId, status])
}

// One store's price for a deal (the "choose where to buy" rows)
model Offer {
  id            String      @id @default(cuid())
  dealId        String
  deal          Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  merchantId    String
  merchant      Merchant    @relation(fields: [merchantId], references: [id])
  price         Decimal     @db.Decimal(12, 2) // what the shopper pays now (sale price if on sale)
  listPrice     Decimal?    @db.Decimal(12, 2) // the source's "was"/list price, only if the source provides it
  currency      String      @default("USD")
  url           String // product page at the merchant
  deliveryNote  String?
  speedRank     Int         @default(5) // 0 = fastest
  inStock       Boolean     @default(true)
  condition     String      @default("new") // new | refurbished | used
  lastCheckedAt DateTime    @default(now()) // when the source last confirmed this price
  staleAfter    DateTime? // after this the price is not shown as current (null = no expiry, demo only)
  sourceId      String?
  source        DataSource? @relation(fields: [sourceId], references: [id])
  retailerSku   String? // the retailer's own product ID from the source
  clicks        Click[]

  @@unique([dealId, merchantId])
  @@unique([sourceId, retailerSku])
  @@index([staleAfter])
}

enum ClickOutcome {
  TRACKED // sent through an approved program's tracking link
  PLAIN // sent to the store's own page, no affiliate tracking (no approved program)
  FALLBACK // a tracked link was expected but could not be built; sent plain
}

// One "Go to store" click. The click ID is also what we pass to the network as the sub-ID,
// so commission reports can be matched back to the click. Minimal data: no IP address, no user agent.
model Click {
  id               String            @id @default(cuid())
  offerId          String
  offer            Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  source           String? // placement: web-deal-page, web-picker, assistant, android, ios...
  sessionId        String? // anonymous visitor ID, only when the visitor consented (none collected yet)
  recommendationId String? // assistant answer or shopping session that led here
  programId        String?
  program          AffiliateProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  outcome          ClickOutcome      @default(PLAIN)
  destinationHost  String? // where we sent them, e.g. "www.bestbuy.com" or the network's tracking host
  createdAt        DateTime          @default(now())
  commissions      Commission[]

  @@index([offerId])
  @@index([createdAt])
  @@index([programId, createdAt])
}

enum ProgramStatus {
  NOT_APPLIED
  APPLIED
  APPROVED // only approved programs ever produce tracked links
  REJECTED
  PAUSED
}

enum LinkMethod {
  NONE // no verified way to make tracked links yet
  AMAZON_TAG // Amazon Associates: adds the account's tracking ID as the "tag" parameter
  DEEPLINK_TEMPLATE // the network's own deep-link format, pasted from its dashboard (see linkTemplate)
}

// Our relationship with one store through one affiliate network (or directly).
// Nothing here is a secret: API keys stay in the API's environment.
model AffiliateProgram {
  id                   String             @id @default(cuid())
  merchantId           String
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  network              String // amazon, impact, cj, awin, rakuten, ebay, travelpayouts, direct
  name                 String
  status               ProgramStatus      @default(NOT_APPLIED)
  linkMethod           LinkMethod         @default(NONE)
  accountTag           String? // AMAZON_TAG: the Associates tracking ID. Other networks: your public account/campaign ID
  linkTemplate         String? // DEEPLINK_TEMPLATE: exact URL from the network, with {url}/{urlEncoded} and {clickId} placeholders
  allowedTrackingHosts String[]           @default([]) // hosts the template may point at (e.g. "goto.example-network.com")
  disclosureText       String? // wording the program requires next to its links
  commissionNotes      String? // verified terms only
  applicationUrl       String?
  appliedAt            DateTime?
  approvedAt           DateTime?
  notes                String?
  reportConfig         Json? // commission report column names and status mapping
  clicks               Click[]
  commissions          Commission[]
  imports              CommissionImport[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([merchantId, network])
}

enum CommissionStatus {
  PENDING // reported, not yet confirmed by the merchant
  APPROVED // confirmed, not yet paid
  REVERSED // returned or cancelled: not earned
  PAID
}

// One reported sale/commission from a network report. Estimates are never stored here, only what the network reports.
model Commission {
  id         String           @id @default(cuid())
  programId  String
  program    AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  externalId String // the network's own ID for this action; makes re-importing safe
  clickId    String? // matched through the sub-ID we passed
  click      Click?           @relation(fields: [clickId], references: [id], onDelete: SetNull)
  subId      String? // what the network says we sent
  status     CommissionStatus
  saleAmount Decimal?         @db.Decimal(12, 2)
  amount     Decimal          @db.Decimal(12, 2) // our commission as reported
  currency   String           @default("USD")
  occurredAt DateTime
  importId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([programId, externalId])
  @@index([programId, status])
  @@index([occurredAt])
}

model CommissionImport {
  id        String           @id @default(cuid())
  programId String
  program   AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  fileHash  String
  rowsRead  Int              @default(0)
  created   Int              @default(0)
  updated   Int              @default(0)
  unchanged Int              @default(0)
  rejected  Int              @default(0)
  matched   Int              @default(0) // rows tied back to one of our clicks
  errors    Json?
  createdAt DateTime         @default(now())

  @@index([programId, createdAt])
}

model PriceHistory {
  id         String      @id @default(cuid())
  dealId     String
  deal       Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  price      Decimal     @db.Decimal(12, 2)
  recordedAt DateTime    @default(now())
  sourceId   String? // provenance; history is deleted per the source's retention rule
  source     DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  merchantId String?

  @@index([dealId, recordedAt])
  @@index([sourceId, recordedAt])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  image        String?
  tier         Tier          @default(FREE)
  goldRenewsAt DateTime?
  saved        SavedDeal[]
  alerts       Alert[]
  clicks       Click[]
  chats        ChatSession[]
  createdAt    DateTime      @default(now())
}

model SavedDeal {
  userId    String
  dealId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, dealId])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  query       String?
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())
}

// One AI assistant run. Counts, cost and timing only: never the shopper's message or the model's answer.
model AiUsage {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  kind             String // assistant
  model            String
  outcome          String // ok | fallback_nokey | fallback_budget | fallback_error | blocked_claim | refusal | limit
  turns            Int      @default(0)
  toolCalls        Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(10, 6)
  priceKnown       Boolean  @default(true) // false: model not in our price table, costed at the highest tier
  latencyMs        Int      @default(0)
  error            String? // short error class, never message content

  @@index([createdAt])
  @@index([outcome, createdAt])
}

// ---------- Partner outreach (admin only) ----------

enum PartnerStatus {
  NEW // not contacted yet
  CONTACTED // first email sent, waiting
  REPLIED // they wrote back; follow-ups stop
  PARTNERED
  DECLINED
  OPTED_OUT // asked not to be emailed; never email again
  BOUNCED // address doesn't work
}

enum EmailStatus {
  DRAFT // waiting for the owner's approval
  APPROVED // approved; the sender sends it during business hours
  SENT
  SKIPPED
  FAILED
}

// A brand, store or network we want to work with.
model Partner {
  id              String          @id @default(cuid())
  name            String
  website         String?
  category        String?
  network         String? // impact, cj, rakuten, awin, direct...
  contactName     String?
  email           String?
  sourceUrl       String? // where we found the contact (must be a public partner/affiliate page)
  status          PartnerStatus   @default(NEW)
  notes           String?
  lastContactedAt DateTime?
  emails          OutreachEmail[]
  inbound         InboundEmail[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([email])
}

model EmailTemplate {
  id        String          @id @default(cuid())
  name      String
  step      Int             @default(0) // 0 = first email, 1 and 2 = follow-ups
  subject   String
  body      String // merge fields: {{brand}} {{firstName}} {{category}} {{website}}
  emails    OutreachEmail[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model OutreachEmail {
  id         String         @id @default(cuid())
  partnerId  String
  partner    Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  step       Int            @default(0)
  toEmail    String
  subject    String
  body       String
  status     EmailStatus    @default(DRAFT)
  approvedAt DateTime?
  sentAt     DateTime?
  gmailId    String?
  threadId   String?
  messageId  String? // RFC Message-ID header, for threading follow-ups
  error      String?
  createdAt  DateTime       @default(now())

  @@index([status])
  @@index([partnerId])
}

// Replies and other mail that arrived in the outreach inbox.
model InboundEmail {
  id         String   @id @default(cuid())
  gmailId    String   @unique
  threadId   String?
  partnerId  String?
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  fromEmail  String
  fromName   String?
  subject    String
  snippet    String
  body       String
  kind       String   @default("reply") // reply | bounce | optout | other
  read       Boolean  @default(false)
  receivedAt DateTime

  @@index([read])
}

// Addresses we must never email again (opt-outs and bounces).
model Suppression {
  email     String   @id
  reason    String // optout | bounce | manual
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
