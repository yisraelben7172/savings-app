// Vault deals database
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  GOLD
}

enum DealStatus {
  ACTIVE
  HIDDEN
  EXPIRED
}

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  color     String // design token name, e.g. "sky"
  sortOrder Int    @default(0)
  deals     Deal[]
}

// A store. Only approved merchants with trustScore >= 70 are ever shown.
model Merchant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  domain       String   @unique // links must point at this domain
  network      String // amazon, ebay, impact, cj, expedia, booking, travelpayouts...
  affiliateTag String? // e.g. Amazon associate tag
  trustScore   Int      @default(0)
  approved     Boolean  @default(false)
  rating       Float?
  color        String   @default("sky")
  offers       Offer[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Deal {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String?
  imageUrl       String?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  originalPrice  Decimal        @db.Decimal(12, 2)
  bestPrice      Decimal        @db.Decimal(12, 2)
  priceUnit      String? // "per day", "per night"
  discountPct    Int
  isHot          Boolean        @default(false)
  goldOnly       Boolean        @default(false)
  goldEarlyUntil DateTime? // free users see it only after this time
  status         DealStatus     @default(ACTIVE)
  expiresAt      DateTime?
  offers         Offer[]
  priceHistory   PriceHistory[]
  savedBy        SavedDeal[]
  alerts         Alert[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId, status])
}

// One store's price for a deal (the "choose where to buy" rows)
model Offer {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  price         Decimal  @db.Decimal(12, 2)
  url           String // product page at the merchant
  deliveryNote  String?
  speedRank     Int      @default(5) // 0 = fastest
  inStock       Boolean  @default(true)
  lastCheckedAt DateTime @default(now())
  clicks        Click[]

  @@unique([dealId, merchantId])
}

model Click {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  source    String? // web, android, ios, assistant
  createdAt DateTime @default(now())

  @@index([offerId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  @@index([dealId, recordedAt])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  image        String?
  tier         Tier          @default(FREE)
  goldRenewsAt DateTime?
  saved        SavedDeal[]
  alerts       Alert[]
  clicks       Click[]
  chats        ChatSession[]
  createdAt    DateTime      @default(now())
}

model SavedDeal {
  userId    String
  dealId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, dealId])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  query       String?
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())
}

// ---------- Partner outreach (admin only) ----------

enum PartnerStatus {
  NEW // not contacted yet
  CONTACTED // first email sent, waiting
  REPLIED // they wrote back; follow-ups stop
  PARTNERED
  DECLINED
  OPTED_OUT // asked not to be emailed; never email again
  BOUNCED // address doesn't work
}

enum EmailStatus {
  DRAFT // waiting for the owner's approval
  APPROVED // approved; the sender sends it during business hours
  SENT
  SKIPPED
  FAILED
}

// A brand, store or network we want to work with.
model Partner {
  id              String          @id @default(cuid())
  name            String
  website         String?
  category        String?
  network         String? // impact, cj, rakuten, awin, direct...
  contactName     String?
  email           String?
  sourceUrl       String? // where we found the contact (must be a public partner/affiliate page)
  status          PartnerStatus   @default(NEW)
  notes           String?
  lastContactedAt DateTime?
  emails          OutreachEmail[]
  inbound         InboundEmail[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([email])
}

model EmailTemplate {
  id        String          @id @default(cuid())
  name      String
  step      Int             @default(0) // 0 = first email, 1 and 2 = follow-ups
  subject   String
  body      String // merge fields: {{brand}} {{firstName}} {{category}} {{website}}
  emails    OutreachEmail[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model OutreachEmail {
  id         String         @id @default(cuid())
  partnerId  String
  partner    Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  step       Int            @default(0)
  toEmail    String
  subject    String
  body       String
  status     EmailStatus    @default(DRAFT)
  approvedAt DateTime?
  sentAt     DateTime?
  gmailId    String?
  threadId   String?
  messageId  String? // RFC Message-ID header, for threading follow-ups
  error      String?
  createdAt  DateTime       @default(now())

  @@index([status])
  @@index([partnerId])
}

// Replies and other mail that arrived in the outreach inbox.
model InboundEmail {
  id         String   @id @default(cuid())
  gmailId    String   @unique
  threadId   String?
  partnerId  String?
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  fromEmail  String
  fromName   String?
  subject    String
  snippet    String
  body       String
  kind       String   @default("reply") // reply | bounce | optout | other
  read       Boolean  @default(false)
  receivedAt DateTime

  @@index([read])
}

// Addresses we must never email again (opt-outs and bounces).
model Suppression {
  email     String   @id
  reason    String // optout | bounce | manual
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
